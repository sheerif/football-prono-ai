# Copy to .env and set unique credentials. The application refuses defaults
# such as admin/admin and does not persist authentication in the URL.
APP_USERNAME=
APP_PASSWORD=
API_FOOTBALL_KEY=your_api_key_here
# Optional: a separate browser key takes priority. Without it, the widget uses
# API_FOOTBALL_KEY, which makes that key visible to authenticated users.
API_FOOTBALL_WIDGET_KEY=
API_FOOTBALL_HTTP_RETRIES=3
# Les xG sont prioritaires, mais cette réserve quotidienne reste disponible
# pour les matchs courants, classements, compositions et prédictions.
XG_DAILY_RESERVE=1500
# Pause entre deux téléchargements de conseils API (synchronisation exhaustive).
PREDICTION_SYNC_PAUSE_SECONDS=0.25
DATABASE_URL=sqlite:///football.db
# Base distante persistante, prioritaire lorsque les deux valeurs sont valides.
TURSO_ENABLED=false
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Mode normal : lectures/écritures locales, puis synchronisation avec Turso.
# Le mode direct est réservé aux runners éphémères comme GitHub Actions.
TURSO_ACCESS_MODE=replica
TURSO_LOCAL_DATABASE_PATH=football-cache.db
TURSO_SYNC_PULL_INTERVAL_SECONDS=3600
TURSO_SYNC_PUSH_RETRY_SECONDS=300
TURSO_SYNC_STRICT_PUSH=false
# Pull différentiel en arrière-plan ; 0 désactive le suivi en temps réel.
TURSO_REALTIME_SYNC_SECONDS=10
AUTO_REFRESH_ON_CONNECTION=true
AUTO_REFRESH_CURRENT_ON_CONNECTION=true
AUTO_REFRESH_START_SEASON=2016
AUTO_REFRESH_END_SEASON=2026
AUTO_REFRESH_LEAGUE_IDS=61,39,140,135,78,2
AUTO_REFRESH_RECENT_SEASONS=2
AUTO_REFRESH_INTERVAL_MINUTES=360
AUTO_REFRESH_PAUSE_SECONDS=0.8
AUTO_REFRESH_MAX_RETRIES=3
